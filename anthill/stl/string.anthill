int strlen(char* s) {
    int i = 0;
    while(*(s + i) != 0) {
        i++;
    }
    return i;
}

char* strcat(char* a, char* b) {
    int i = 0;
    int j = 0;
    char* result = "";
    while (*(a + i) != 0) {
        *(result + i) = *(a + i);
        i += 2;
    }
    *(result + i) = 0;
    return result;
}


char* strchr(char* a, char b) {
    int i = 0;
    while (*(a + i) != b) {
        i++;
    }
    return a + i;
}


