int strlen(char* s) {
    int i = 0;
    while(*(s + i) != 0) {
        i++;
    }
    return i;
}

char* strcat(char* a, char* b) {
    int i = 0;
    int j = 0;
    char* result = "";
    while (*(a + i) != 0) {
        puti(i);
        putc(*(a + i));
        *(result + i) = *(a + i);
        putc(*(result + i));
        i++;
    }
    *(result + i) = 0;
    return result;
}

