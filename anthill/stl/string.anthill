int strlen(char* s) {
    int i = 0;
    while(*(s + i) != 0) {
        i++;
    }
    return i;
}

void* strcat(char* dst, char* a, char* b) {
    int i = 0;
    int j = 0;
    while (*(a + i) != '\0') {
        *(dst + i) = *(a + i);
        i++;
    }
    while (*(b + j) != '\0') {
        *(dst + i + j) = *(b + j);
        j++;
    }
    *(dst + i + j) = 0;
}


char* strchr(char* a, char b) {
    int i = 0;
    while (*(a + i) != b) {
        i++;
    }
    return a + i;
}

void memcpy(void* dst, void* src, int n) {
    int i = 0;
    while (i < n) {
        *(dst + i) = *(src + i);
        i++;  
    }
}
