int strlen(char* s) {
    int i = 0;
    while(*(s + i) != 0) {
        i++;
    }
    return i;
}

char* strcat(char* a, char* b) {
    char* result = "Hg";
    int i = 0;
    int j = 0;
    while (*(a + i) != 0) {
        *(result + i) = *(a + i);
        i++;
    }
    while (*(b + j) != 0) {
        *(result + i) = *(b + i);
        i++;
        j++;
    }
    *(result + i) = 0;
    return result;
}

