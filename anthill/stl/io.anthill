void putc(char c) {
    c;
    __asm__("mov %ax,%dx\nmov $0nD0,%ax\nint $0\nmov %dx,%ax\n");
}

void puti(int i) {
    i;
    __asm__("mov %ax,%dx\nmov $0nDC,%ax\nint $0\nmov %dx,%ax\n");
}


void putf(float f) {
    f;
    __asm__("fld %ax\nmov $0nCA,%ax\nint $0\nfstp %ax\n");
}

void puts(char* s) {
    int i = 0;
    while (*(s + i) != '\0') {
        puti(*(s + i));
        i += 2;
    }
}


int fact(int x) {
    int i = 1;
    int result = 1;
    while (i <= x) {
        result = result * i;
        i++;
    }
    return result;
}

char getc() {
    __asm__("mov $0,%dx\nmov $0nCC,%ax\nint $0\nmov %dx,%ax\nmov %bp,%sp\n");
}

int geti() {
    __asm__("mov $0nD3,%ax\nint $0\nmov %dx,%ax\nmov %bp,%sp\n");
}