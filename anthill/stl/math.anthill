float M_PI = 3.141592653589793;
float M_E = 2.718281828459045;

float sqrt(float a) {
    a;
    __asm__("fld %ax\nfsqrt\nfstp %ax\n");
}

float sin(float a) {
    a;
    __asm__("fld %ax\nfsin\nfstp %ax\n");
}

float cos(float a) {
    a;
    __asm__("fld %ax\nfcos\nfstp %ax\n");
}

float tan(float a) {
    a;
    __asm__("fld %ax\nftan\nfstp %ax\n");
}

float atan2(float a, float b) {
    a;
    __asm__("fld %ax\n");
    b;
    __asm__("fld %ax\n");
    __asm__("fatan\nfstp %ax\n");
}

float atan(float a) {
    return atan2(a,1.0);
}

float asin(float a) {
    return atan2(a,sqrt(1.0-a*a));
}

float acos(float a) {
    return M_PI/2.0 - asin(a);
}

float exp(float a) {
    a;
    __asm__("fld %ax\nfexp\nfstp %ax\n");
}

float log(float a) {
    a;
    __asm__("fld %ax\nflog\nfstp %ax\n");
}

float log3(float a) {
    return log(a) / log(3.0);
}

float pow(float a, float b) {
    return exp(b * log(a));
}

float floor(float a) {
    a;
    __asm__("fld %ax\nffloor\nfstp %ax\n");
}

float round(float a) {
    return floor(a+1.0);
}

float hypot(float a, float b) {
    return sqrt(a * a + b *b);
}

float f_abs(float a) {
    a;
    __asm__("fld %ax\nfabs\nfstp %ax\n");
}

float fmin(float a, float b) {
    if(a < b) {
        return a;
    } else {
        return b;
    }
}

float fmax(float a, float b) {
    if(a > b) {
        return a;
    } else {
        return b;
    }
}