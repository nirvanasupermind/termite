#define M_PI (3.141592653589793)
#define M_E (2.718281828459045)
#define M_PI_2 (1.5707963267948966)
#define M_SQRT2 (1.4142135623730951)
#define INFINITY (1.0/0.0)
#define NAN (0.0/0.0)

float sqrt(float a) {
    a;
    __asm__("fld %ax\nfsqrt\nfstp %ax\n");
}

float sin(float a) {
    a;
    __asm__("fld %ax\nfsin\nfstp %ax\n");
}

float cos(float a) {
    a;
    __asm__("fld %ax\nfcos\nfstp %ax\n");
}

float tan(float a) {
    a;
    __asm__("fld %ax\nftan\nfstp %ax\n");
}

float atan2(float a, float b) {
    a;
    __asm__("fld %ax\n");
    b;
    __asm__("fld %ax\n");
    __asm__("fatan\nfstp %ax\n");
}

float atan(float a) {
    return atan2(a,1.0);
}

float asin(float a) {
    return atan2(a,sqrt(1.0-a*a));
}

float acos(float a) {
    return M_PI_2 - asin(a);
}

float exp(float a) {
    a;
    __asm__("fld %ax\nfexp\nfstp %ax\n");
}

float log(float a) {
    a;
    __asm__("fld %ax\nflog\nfstp %ax\n");
}

float log3(float a) {
    return log(a) / log(3.0);
}

float log10(float a) {
    return log(a) / log(10.0);
}

float pow(float a, float b) {
    return exp(b * log(a));
}

float floor(float a) {
    a;
    __asm__("fld %ax\nffloor\nfstp %ax\n");
}

float ceil(float a) {
    return -floor(-a);
}

float round(float a) {
    return floor(a+0.5);
}

float trunc(float a) {
    if(a < 0.0) {
        return -floor(-a);
    } else {
        return floor(a);
    }
}

float hypot(float a, float b) {
    return sqrt(a * a + b *b);
}

float f_abs(float a) {
    a;
    __asm__("fld %ax\nfabs\nfstp %ax\n");
}

float fmin(float a, float b) {
    if(a < b) {
        return a;
    } else {
        return b;
    }
}

float fmax(float a, float b) {
    if(a > b) {
        return a;
    } else {
        return b;
    }
}

int isfinite(float a) {
    return a != INFINITY && a != (-INFINITY) && a != NAN;
}

int isinf(float a) {
    return a == INFINITY || a == (-INFINITY);
}

int isnan(float a) {
    int *ptr = (int*)a;
    int exponent = *(int*)(((int)ptr) +2);
    
    return (exponent == 21523360) && !(isinf(a));
}