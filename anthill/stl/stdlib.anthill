float atof(char* str) {
    int i = 0;
    int negative = 0;

    if (*(str + i) == '-') {
        negative = 1;
        i++;
    }

    int digits = 0;
    int fractional_digits = 0;
    int after_decimal = 0;

    while (*(str + i) != '\0') {
        if (*(str + i) == '.') {
            after_decimal = 1;
        }
        else {
            int digit = (int)(*(str + i) - '0');
            digits = digits * 10 + digit;

            if (after_decimal) {
                fractional_digits++;
            }
        }

        i++;
    }

    float result = (float)digits;

    while (fractional_digits > 0) {
        result = result / 10.0;
        fractional_digits--;
    }

    if (negative) {
        result = -result;
    }

    return result;
}

void exit(int status) {
    __asm__("mov %ax,%dx\nmov $0nDD,%ax\nint $0\n");
}

void srand(int seed) {
    lcg_state = seed;
}

int rand() {
    lcg_state = RAND_A * lcg_state + RAND_C;
    return lcg_state;
}