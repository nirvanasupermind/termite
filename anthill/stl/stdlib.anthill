#include "anthill/stl/math.anthill"

#define RAND_MAX 21523360
#define RAND_A 1664524
#define RAND_C 23829640

int lcg_state = 1;


void* calloc(int amount, int size) {
    char x = '\0';
    char* result = &x;
    for(int i = 1; i < (amount * size); i++) {
        *(result + i) = 0;
    }
    return (void*)result;
}

int abs(int a) {
    if(a < 0) {
        return -a;
    } else {
        return a;
    }
}

int atoi(char* str) {
    int i = 0;
    if(*str == '-') {
        return -atoi(str + 1);
    }
    int result = 0;
    while(*(str + i) != '\0') {
        char current_char = *(str + i);
        result = 10 * result + (current_char - '0');
        i++;
    }
    return result;
}

float atof(char* str) {
    int i = 0;
     while(*(str + i) != '.') {
        i++;
    }
    char* pre_dot_str = (char*)(calloc(i,1));
    for(int j = 0; j < i; j++) {
        *(pre_dot_str + j) = *(str + j);
    }
    char* post_dot_str = str + i;
    int post_dot_str_length = 0;
    while(*(post_dot_str + post_dot_str_length) != 0) {
        post_dot_str_length += 1;
    }

    float int_part = (float)(atoi(pre_dot_str));
    puts("Post dot str length: ");
    putf(-((float)(post_dot_str_length)));
    putc('\n');
    // float frac_part = ((float)(atoi(post_dot_str))) * pow(10.0,-((float)(post_dot_str_length)));
    return int_part;
}


void exit(int status) {
    __asm__("mov %ax,%dx\nmov $0nDD,%ax\nint $0\n");
}

void srand(int seed) {
    lcg_state = seed;
}

int rand() {
    lcg_state = RAND_A * lcg_state + RAND_C;
    return lcg_state;
}