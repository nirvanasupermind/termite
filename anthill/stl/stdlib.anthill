int abs(int a) {
    if(a < 0) {
        return -a;
    } else {
        return a;
    }
}

int atoi(char* str) {
    int i = 0;
    int result = 0;
    while(*(str + i) != '\0') {
        char current_char = *(str + i);
        if (current_char == '0') {
            result = 10 * result;
        }
        if (current_char == '1') {
            result = 10 * result + 1;
        }
        if (current_char == '2') {
            result = 10 * result + 2;
        }
        if (current_char == '3') {
            result = 10 * result + 3;
        }
        if (current_char == '4') {
            result = 10 * result + 4;
        }
        if (current_char == '5') {
            result = 10 * result + 5;
        }
        if (current_char == '6') {
            result = 10 * result + 6;
        }
        if (current_char == '7') {
            result = 10 * result + 7;
        }
        if (current_char == '8') {
            result = 10 * result + 8;
        }
        if (current_char == '9') {
            result = 10 * result + 9;
        }
        i++;
    }
    return i;
}

