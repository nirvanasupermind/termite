int isupper(char c) {
    return c == 'A' | c == 'B' | c == 'C' | c == 'D' | c == 'E' | c == 'F' | c == 'G'
        | c == 'H' | c == 'I' | c == 'J' | c == 'K' | c == 'L' | c == 'M' | c == 'N'
        | c == 'O' | c == 'P' | c == 'Q' | c == 'R' | c == 'S' | c == 'T' | c == 'U'
        | c == 'V' | c == 'W' | c == 'X' | c == 'Y' | c == 'Z';
}


int islower(char c) {
    return c == 'a' | c == 'b' | c == 'c' | c == 'd' | c == 'e' | c == 'f' | c == 'g'
        | c == 'h' | c == 'i' | c == 'j' | c == 'k' | c == 'l' | c == 'm' | c == 'n'
        | c == 'o' | c == 'p' | c == 'q' | c == 'r' | c == 's' | c == 't' | c == 'u'
        | c == 'v' | c == 'w' | c == 'x' | c == 'y' | c == 'z';
}

int isalpha(char c) {
    return isupper(c) | islower(c);
}

int isdigit(char c) {
    return c == '0' | c == '1' | c == '2' | c == '3' | c == '4' | c == '5' | c == '6'
        | c == '7' | c == '8' | c == '9';
}


int isalnum(char c) {
    return isalpha(c)| isdigit(c);
}

int ispunct(char c) {
     return c == '!' | c == '"' | c == '$' | c == '%' | c == '&' | c == '\'' | c == '('
        | c == ')' | c == '*' | c == '+'| c == ',' | c == '-' | c == '-' | c == '.' | c == '/'
        |c==':'|c=';'|c=='<'|c=='='|c=='>'|c=='?'|c=='@'|c=='['|c=='\'|c==']'|c=='^'|c=='_'|c=='{'|c=='|'|c=='}'|c=='~';   
}

int isspace(char c) {
     return c == ' ' | c == '\t' | c == '\n';
}
