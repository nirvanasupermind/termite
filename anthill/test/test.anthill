#include "anthill/stl/math.anthill"
#include "anthill/stl/io.anthill"


int main() {
    putf(sqrt(2.0));
    putc('\n');
    putf(sin(2.0));
    putc('\n');
    putf(cos(2.0));
    putc('\n');
    putf(tan(2.0));
    putc('\n');
   putf(log(2.0));
    putc('\n');
   putf(exp(2.0));
    putc('\n');

    return 0;
}