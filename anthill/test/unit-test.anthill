void print_char(char c) {
    c;
    __asm__("mov %ax,%dx\nmov $0nD0,%ax\nint $0\n");
}

void print_int(int i) {
    i;
    __asm__("mov %ax,%dx\nmov $0nDC,%ax\nint $0\n");
}

void print_str(char* s) {
    int i = 0;
    while(*(s + i) != 0) {
        print_char(*(s + i));
        i++;
    }
}

void test_cast() {
    print_char('c');
    print_char('a');
    print_char('s');
    print_char('t');
    print_char(':');
    print_char(' ');
    print_int(((char)86438) == 1145);
    print_char('\n');
}

void test_inc() {
    print_char('i');
    print_char('n');
    print_char('c');
    print_char(':');
    print_char(' ');
    int x = 57;
    x++;
    print_int(x == 58);
    print_char('\n');
}


void test_dec() {
    print_char('d');
    print_char('e');
    print_char('c');
    print_char(':');
    print_char(' ');
    int x = 100;
    x--;
    print_int(x == 99);
    print_char('\n');
}

void test_ptr_deref() {
    print_char('p');
    print_char('t');
    print_char('r');
    print_char('_');
    print_char('d');
    print_char('e');
    print_char('r');
    print_char('e');
    print_char('f');
    print_char(':');
    print_char(' ');
    int x = 14;
    print_int(*&x == 14);
    print_char('\n');
}

void test_uminus() {
    print_char('u');
    print_char('m');
    print_char('i');
    print_char('n');
    print_char('u');
    print_char('s');
    print_char(':');
    print_char(' ');
    print_int(-(-22) == 22);
    print_char('\n');
}

void test_uminus2() {
    print_char('u');
    print_char('m');
    print_char('i');
    print_char('n');
    print_char('u');
    print_char('s');
    print_char('2');
    print_char(':');
    print_char(' ');
    int x = -93;
    print_int(-x == 93);
    print_char('\n');
}

void test_uplus() {
    print_char('u');
    print_char('p');
    print_char('l');
    print_char('u');
    print_char('s');
    print_char(':');
    print_char(' ');
    print_int(+67 == 67);
    print_char('\n');
}


void test_and() {
    print_char('a');
    print_char('n');
    print_char('d');
    print_char(':');
    print_char(' ');
    print_int((-67 & 95) == -67);
    print_char('\n');
}

void test_or() {
    print_char('o');
    print_char('r');
    print_char(':');
    print_char(' ');
    print_int((47 | 69) == 75);
    print_char('\n');
}

void test_xor() {
    print_char('x');
    print_char('o');
    print_char('r');
    print_char(':');
    print_char(' ');
    print_int((-18 ^ -14) == 18);
    print_char('\n');
}

void test_shl() {
    print_char('s');
    print_char('h');
    print_char('l');
    print_char(':');
    print_char(' ');
    print_int((23 << 1) == 69);
    print_char('\n');
}

void test_add() {
    print_char('a');
    print_char('d');
    print_char('d');
    print_char(':');
    print_char(' ');
    print_int((618039+206056) == 824095);
    print_char('\n');
}

void test_sub() {
    print_char('s');
    print_char('u');
    print_char('b');
    print_char(':');
    print_char(' ');
    print_int((-832341-883287) == -1715628);
    print_char('\n');
}

void test_mul() {
    print_char('s');
    print_char('u');
    print_char('b');
    print_char(':');
    print_char(' ');
    print_int((869328*-655735)==18930123);
    print_char('\n');
}

void test_div() {
    print_char('d');
    print_char('i');
    print_char('v');
    print_char(':');
    print_char(' ');
    print_int((565466/110934)==5);
    print_char('\n');
}

void test_mod() {
    print_char('m');
    print_char('o');
    print_char('d');
    print_char(':');
    print_char(' ');
    print_int((494105%26819)==11363);
    print_char('\n');
}

int main() {
    test_cast();
    test_inc();
    test_dec();
    test_ptr_deref();
    test_uminus();
    test_uminus2();
    test_uplus();
    test_and();
    test_or();
    test_xor();
    test_shl();
    test_add();
    test_sub();
    test_mul();
    test_div();
    test_mod();
    return 0;
}