    putchar('e');
    putchar('q');
    putchar(':');
    putchar(' ');
    puti(-681521==-681521);
    putchar('\n');
}

void test_ne() {
    putchar('n');
    putchar('e');
    putchar(':');
    putchar(' ');
    puti(-417075!=195894);
    putchar('\n');
}

