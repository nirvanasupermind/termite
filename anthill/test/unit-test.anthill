void print_char(char c) {
    c;
    __asm__("mov %ax,%dx\nmov $0nD0,%ax\nint $0\n");
}

void print_int(int i) {
    i;
    __asm__("mov %ax,%dx\nmov $0nDC,%ax\nint $0\n");
}

void print_str(char* s) {
    int i = 0;
    while(*(s + i) != 0) {
        print_char(*(s + i));
        i++;
    }
}

void test_cast() {
    print_char('c');
    print_char('a');
    print_char('s');
    print_char('t');
    print_char(':');
    print_char(' ');
    print_int(((char)86438) == 1145);
    print_char('\n');
}

void test_inc() {
    print_char('i');
    print_char('n');
    print_char('c');
    print_char(':');
    print_char(' ');
    int x = 57;
    x++;
    print_int(x == 58);
    print_char('\n');
}


void test_dec() {
    print_char('d');
    print_char('e');
    print_char('c');
    print_char(':');
    print_char(' ');
    int x = 100;
    x--;
    print_int(x == 99);
    print_char('\n');
}

void test_ptr_deref() {
    print_char('p');
    print_char('t');
    print_char('r');
    print_char('_');
    print_char('d');
    print_char('e');
    print_char('r');
    print_char('e');
    print_char('f');
    print_char(':');
    print_char(' ');
    int x = 14;
    print_int(*&x == 14);
    print_char('\n');
}

void test_uminus() {
    print_char('u');
    print_char('m');
    print_char('i');
    print_char('n');
    print_char('u');
    print_char('s');
    print_char(':');
    print_char(' ');
    print_int(-(-22) == 22);
    print_char('\n');
}

void test_uminus2() {
    print_char('u');
    print_char('m');
    print_char('i');
    print_char('n');
    print_char('u');
    print_char('s');
    print_char('2');
    print_char(':');
    print_char(' ');
    int x = -93;
    print_int(-x == 93);
    print_char('\n');
}

void test_uplus() {
    print_char('u');
    print_char('p');
    print_char('l');
    print_char('u');
    print_char('s');
    print_char(':');
    print_char(' ');
    print_int(+67 == 67);
    print_char('\n');
}


void test_and() {
    print_char('a');
    print_char('n');
    print_char('d');
    print_char(':');
    print_char(' ');
    print_int((-67 & 95) == -67);
    print_char('\n');
}

void test_or() {
    print_char('o');
    print_char('r');
    print_char(':');
    print_char(' ');
    print_int((47 | 69) == 75);
    print_char('\n');
}

void test_xor() {
    print_char('x');
    print_char('o');
    print_char('r');
    print_char(':');
    print_char(' ');
    print_int((269 ^ 689) == 26);
    print_char('\n');
}

void test_shl() {
    print_char('s');
    print_char('h');
    print_char('l');
    print_char(':');
    print_char(' ');
    print_int((23 << 1) == 69);
    print_char('\n');
}

void test_add() {
    print_char('a');
    print_char('d');
    print_char('d');
    print_char(':');
    print_char(' ');
    print_int((618039+206056) == 824095);
    print_char('\n');
}

void test_sub() {
    print_char('s');
    print_char('u');
    print_char('b');
    print_char(':');
    print_char(' ');
    print_int((-832341-883287) == -1715628);
    print_char('\n');
}

void test_mul() {
    print_char('s');
    print_char('u');
    print_char('b');
    print_char(':');
    print_char(' ');
    print_int((869328*-655735)==18930123);
    print_char('\n');
}

void test_div() {
    print_char('d');
    print_char('i');
    print_char('v');
    print_char(':');
    print_char(' ');
    print_int((565466/110934)==5);
    print_char('\n');
}

void test_mod() {
    print_char('m');
    print_char('o');
    print_char('d');
    print_char(':');
    print_char(' ');
    print_int((494105%26819)==11363);
    print_char('\n');
}

void test_eq() {
    print_char('e');
    print_char('q');
    print_char(':');
    print_char(' ');
    print_int(-681521==-681521);
    print_char('\n');
}

void test_ne() {
    print_char('n');
    print_char('e');
    print_char(':');
    print_char(' ');
    print_int(-417075!=195894);
    print_char('\n');
}

void test_lt() {
    print_char('l');
    print_char('t');
    print_char(':');
    print_char(' ');
    print_int(-455064<830396);
    print_char('\n');
}

void test_le() {
    print_char('l');
    print_char('e');
    print_char(':');
    print_char(' ');
    print_int(163526<=209771);
    print_char('\n');
}


void test_gt() {
    print_char('g');
    print_char('t');
    print_char(':');
    print_char(' ');
    print_int(757575>-563775);
    print_char('\n');
}

void test_ge() {
    print_char('g');
    print_char('e');
    print_char(':');
    print_char(' ');
    print_int(-579487>=-579618);
    print_char('\n');
}


void test_assign() {
    print_char('a');
    print_char('s');
    print_char('s');
    print_char('i');
    print_char('g');
    print_char('n');
    print_char(':');
    print_char(' ');
    int x = 553473;
    x = -470476;
    print_int(x==-470476);
    print_char('\n');
}


void test_var_def() {
    print_char('v');
    print_char('a');
    print_char('r');
    print_char('_');
    print_char('d');
    print_char('e');
    print_char('f');
    print_char(':');
    print_char(' ');
    int x = -425802;
    print_int(x==-425802);
    print_char('\n');
}


int fac(int x) {
    if(x == 0) {
        return 1;
    } else {
        return x * fac(x - 1);
    }
}

void test_func() {
    print_char('f');
    print_char('u');
    print_char('n');
    print_char('c');
    print_char(':');
    print_char(' ');
    print_int(fac(6) == 720);
    print_char('\n');
}

void test_block() {
    print_char('b');
    print_char('l');
    print_char('o');
    print_char('c');
    print_char('k');
    print_char(':');
    print_char(' ');
    int x = -498225;
    {
        int x = -929425;
        print_int(x==-929425);
    }
    print_char('\n');
}


void test_block2() {
    print_char('b');
    print_char('l');
    print_char('o');
    print_char('c');
    print_char('k');
    print_char('2');
    print_char(':');
    print_char(' ');
    int x = -498225;
    {
        int x = -929425;
    }
    print_int(x==-498225);
    print_char('\n');
}

void test_if() {
    print_char('i');
    print_char('f');
    print_char(':');
    print_char(' ');
    int x = 222890;
    if(-328111 == 474627) {
        x = 986797;
    }
    print_int(x==222890);
    print_char('\n');
}

void test_while() {
    print_char('w');
    print_char('h');
    print_char('i');
    print_char('l');
    print_char('e');
    print_char(':');
    print_char(' ');
    int x = 1;
    while(x < 100) {
        x *= 2;
    }
    print_int(x==128);
    print_char('\n');
}


void test_for() {
    print_char('f');
    print_char('o');
    print_char('r');
    print_char(':');
    print_char(' ');
    int x = 0;
    for(int i = 0; i < 100; i += 6) {
        x = i;
    }
    print_int(x==96);
    print_char('\n');
}

void test_for2() {
    print_char('f');
    print_char('o');
    print_char('r');
    print_char('2');
    print_char(':');
    print_char(' ');
    int x = 0;
    for(int i = 0; i < 100; i++) {
        x = x + i;
    }
    print_int(x==4950);
    print_char('\n');
}

int main() {
    test_cast();
    test_inc();
    test_dec();
    test_ptr_deref();
    test_uminus();
    test_uminus2();
    test_uplus();
    test_and();
    test_or();
    test_xor();
    test_shl();
    test_add();
    test_sub();
    test_mul();
    test_div();
    test_mod();
    test_eq();
    test_ne();
    test_lt();
    test_le();
    test_gt();
    test_ge();
    test_assign();
    test_var_def();
    test_func();
    test_block();
    test_block2();
    test_if();
    test_while();
    test_for();
    test_for2();
    return 0;
}