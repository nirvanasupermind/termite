    puti(-579487>=-579618);
    putchar('\n');
}


void test_assign() {
    putchar('a');
    putchar('s');
    putchar('s');
    putchar('i');
    putchar('g');
    putchar('n');
    putchar(':');
    putchar(' ');
    int x = 553473;
    x = -470476;
    puti(x==-470476);
    putchar('\n');
}


void test_var_def() {
    putchar('v');
    putchar('a');
    putchar('r');
    putchar('_');
    putchar('d');
    putchar('e');
    putchar('f');
    putchar(':');
    putchar(' ');
    int x = -425802;
    puti(x==-425802);
    putchar('\n');
}


int fac(int x) {
    if(x == 0) {
        return 1;
    } else {
        return x * fac(x - 1);
    }
}

void test_func() {
    putchar('f');
    putchar('u');
    putchar('n');
    putchar('c');
    putchar(':');
    putchar(' ');
    puti(fac(6) == 720);
    putchar('\n');
}

void test_block() {
    putchar('b');
    putchar('l');
    putchar('o');
    putchar('c');
    putchar('k');
    putchar(':');
    putchar(' ');
    int x = -498225;
    {
        int x = -929425;
        puti(x==-929425);
    }
    putchar('\n');
}


void test_block2() {
    putchar('b');
    putchar('l');
    putchar('o');
    putchar('c');
    putchar('k');
    putchar('2');
    putchar(':');
    putchar(' ');
    int x = -498225;
    {
        int x = -929425;
    }
    puti(x==-498225);
    putchar('\n');
}

void test_if() {
    putchar('i');
    putchar('f');
    putchar(':');
    putchar(' ');
    int x = 222890;
    if(-328111 == 474627) {
        x = 986797;
    }
    puti(x==222890);
    putchar('\n');
}

void test_while() {
    putchar('w');
    putchar('h');
    putchar('i');
    putchar('l');
    putchar('e');
    putchar(':');
    putchar(' ');
    int x = 1;
    while(x < 100) {
        x *= 2;
    }
    puti(x==128);
    putchar('\n');
}


void test_for() {
    putchar('f');
    putchar('o');
    putchar('r');
    putchar(':');
    putchar(' ');
    int x = 0;
    for(int i = 0; i < 100; i += 6) {
        x = i;
    }
    puti(x==96);
    putchar('\n');
}

void test_for2() {
    putchar('f');
    putchar('o');
    putchar('r');
    putchar('2');
    putchar(':');
    putchar(' ');
    int x = 0;
    for(int i = 0; i < 100; i++) {
        x = x + i;
    }
    puti(x==4950);
    putchar('\n');
}

int main() {
    test_cast();
    test_inc();
    test_dec();
    test_ptr_deref();
    test_uminus();
    test_uminus2();
    test_uplus();
    test_and();
    test_or();
    test_xor();
    test_shl();
    test_add();
    test_sub();
    test_mul();
    test_div();
    test_mod();
    test_eq();
    test_ne();
    test_lt();
    test_le();
    test_gt();
    test_ge();
    test_assign();
    test_var_def();
    test_func();
    test_block();
    test_block2();
    test_if();
    test_while();
    test_for();
    test_for2();
    return 0;
}