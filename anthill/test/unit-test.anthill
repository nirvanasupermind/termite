void test_cast() {
    putchar('c');
    putchar('a');
    putchar('s');
    putchar('t');
    putchar(':');
    putchar(' ');
    puti(((char)86438) == 1145);
    putchar('\n');
}

void test_inc() {
    putchar('i');
    putchar('n');
    putchar('c');
    putchar(':');
    putchar(' ');
    int x = 57;
    x++;
    puti(x == 58);
    putchar('\n');
}

void test_dec() {
    putchar('d');
    putchar('e');
    putchar('c');
    putchar(':');
    putchar(' ');
    int x = 100;
    x--;
    puti(x == 99);
    putchar('\n');
}

void test_ptr_deref() {
    putchar('p');
    putchar('t');
    putchar('r');
    putchar('_');
    putchar('d');
    putchar('e');
    putchar('r');
    putchar('e');
    putchar('f');
    putchar(':');
    putchar(' ');
    int x = 14;
    puti(*&x == 14);
    putchar('\n');
}

void test_uminus() {
    putchar('u');
    putchar('m');
    putchar('i');
    putchar('n');
    putchar('u');
    putchar('s');
    putchar(':');
    putchar(' ');
    puti(-(-22) == 22);
    putchar('\n');
}

void test_uminus2() {
    putchar('u');
    putchar('m');
    putchar('i');
    putchar('n');
    putchar('u');
    putchar('s');
    putchar('2');
    putchar(':');
    putchar(' ');
    int x = -93;
    puti(-x == 93);
    putchar('\n');
}

void test_uplus() {
    putchar('u');
    putchar('p');
    putchar('l');
    putchar('u');
    putchar('s');
    putchar(':');
    putchar(' ');
    puti(+67 == 67);
    putchar('\n');
}


void test_and() {
    putchar('a');
    putchar('n');
    putchar('d');
    putchar(':');
    putchar(' ');
    puti((-67 & 95) == -67);
    putchar('\n');
}

void test_or() {
    putchar('o');
    putchar('r');
    putchar(':');
    putchar(' ');
    puti((47 | 69) == 75);
    putchar('\n');
}

void test_xor() {
    putchar('x');
    putchar('o');
    putchar('r');
    putchar(':');
    putchar(' ');
    puti((269 ^ 689) == 26);
    putchar('\n');
}

void test_shl() {
    putchar('s');
    putchar('h');
    putchar('l');
    putchar(':');
    putchar(' ');
    puti((23 << 1) == 69);
    putchar('\n');
}

